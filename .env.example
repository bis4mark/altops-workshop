# Copy to .env and fill in. Never commit .env.
# Used server-side only (api/measure.js) — never exposed to the browser.
ANTHROPIC_API_KEY=sk-ant-...

# Optional — model for the Measure feature. Defaults to claude-opus-5.
# claude-sonnet-5 or claude-haiku-4-5 are cheaper if you run a lot of photos.
MEASURE_MODEL=claude-opus-5
